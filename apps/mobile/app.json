{
  "expo": {
    "name": "MedChina",
    "slug": "medchina",
    "scheme": "medchina",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medchina.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use a biometria apenas para desbloquear localmente seus dados clínicos no MedChina."
      }
    },
    "android": {
      "package": "com.medchina.app",
      "adaptiveIcon": {
        "backgroundColor": "#EEEBE7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.RECORD_AUDIO", "android.permission.POST_NOTIFICATIONS"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "O MedChina usa o microfone para gravar a consulta somente quando você inicia e com o consentimento da paciente."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Use a biometria apenas para desbloquear localmente seus dados clínicos no MedChina."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use a biometria apenas para desbloquear localmente seus dados clínicos no MedChina."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "clinical-status"
        }
      ],
      "expo-background-task"
    ]
  }
}
