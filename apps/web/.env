NEXT_PUBLIC_CDN_URL="/assets/cdn/"
NEXT_PUBLIC_TITLE="Gogo MUI Admin Template"
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_STORAGE_PREFIX="nx"
ENV=test
NEXT_PUBLIC_MUI_X_LICENSE_KEY="YOUR_MUIX_LICENSE_KEY"

# --- Supabase (leave empty to browse the template without auth) ---
# Project URL and anon key: Supabase dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Pooled connection string (port 6543) for @gogo/db (Drizzle).
DATABASE_URL=
# Server-only. Service role key — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Billing (optional; providers without a key are hidden at checkout) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# Default: Asaas sandbox. Production: https://api.asaas.com/v3
ASAAS_BASE_URL=

# --- AI assistants (a provider without a key rejects its assistants) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Background jobs (optional; without keys, work falls back to inline) ---
# Local dev needs no keys: run "npx inngest-cli dev".
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- WhatsApp (optional; without keys, sends fail with a clear hint) ---
# meta = official Cloud API (approved templates); evolution = unofficial (ban risk)
WHATSAPP_PROVIDER=
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_ID=
WHATSAPP_META_VERIFY_TOKEN=
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_WEBHOOK_TOKEN=

# --- Transactional email (optional; invites fall back to copyable links) ---
# Server-only. https://resend.com API key.
RESEND_API_KEY=
# Verified sender, e.g. "Gogo <noreply@yourdomain.com>"
EMAIL_FROM=
