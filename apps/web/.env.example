NEXT_PUBLIC_CDN_URL="/assets/cdn/"
# Canonical site URL in production, no trailing slash (sitemap/robots/OG/JSON-LD
# and mobile universal links fall back to http://localhost:3000 without it).
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_TITLE="Flyee"
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_STORAGE_PREFIX="fly"
ENV=test
NEXT_PUBLIC_MUI_X_LICENSE_KEY="YOUR_MUIX_LICENSE_KEY"

# --- Supabase (leave empty to browse the template without auth) ---
# Project URL and anon key: Supabase dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Pooled connection string (port 6543) for @flyee/db (Drizzle).
DATABASE_URL=
# Server-only. Service role key — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Billing (optional; providers without a key are hidden at checkout) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# Default: Asaas sandbox. Production: https://api.asaas.com/v3
ASAAS_BASE_URL=
# Force a provider when more than one key is set (stripe | asaas). Default: first configured.
BILLING_PROVIDER=asaas

# --- Ads & analytics (optional; empty = no tracker loads, banner stays hidden) ---
# Meta Pixel loads ONLY on the marketing site (never the clinical app).
# Events Manager > Data sources > your dataset > "Pixel ID".
NEXT_PUBLIC_META_PIXEL_ID=
# GA4 Measurement ID (G-XXXXXXXXXX): GA Admin > Data streams > Web stream.
NEXT_PUBLIC_GA4_ID=
# Server-only. Conversions API access token: Events Manager > dataset >
# Settings > Conversions API > "Generate access token". Powers server-side
# InitiateCheckout / Purchase (lib/meta-capi.ts). Never expose to the client.
META_CAPI_TOKEN=
# Optional. Test-events code (Events Manager > Test events) to verify CAPI live.
META_CAPI_TEST_EVENT_CODE=

# --- AI assistants (a provider without a key rejects its assistants) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Background jobs (optional; without keys, work falls back to inline) ---
# Local dev needs no keys: run "npx inngest-cli dev".
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Backups (@flyee/backup; needs DATABASE_URL + SUPABASE_SERVICE_ROLE_KEY) ---
# Days to keep backup runs and their archives before pruning (default 30).
BACKUP_RETENTION_DAYS=

# --- WhatsApp (optional; without keys, sends fail with a clear hint) ---
# meta = official Cloud API (approved templates); evolution = unofficial (ban risk)
WHATSAPP_PROVIDER=
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_ID=
WHATSAPP_META_VERIFY_TOKEN=
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_WEBHOOK_TOKEN=

# --- Transactional email (optional; invites fall back to copyable links) ---
# Server-only. https://resend.com API key.
RESEND_API_KEY=
# Verified sender, e.g. "Flyee <noreply@yourdomain.com>"
EMAIL_FROM=

# --- Mobile universal links (required for store builds) ---
# Apple developer team identifier and SHA-256 fingerprint of the Android
# signing certificate. The web host comes from NEXT_PUBLIC_SITE_URL.
APPLE_TEAM_ID=
ANDROID_CERT_SHA256=
