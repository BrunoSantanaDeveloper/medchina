NEXT_PUBLIC_CDN_URL="/assets/cdn/"
# Canonical site URL in production, no trailing slash (sitemap/robots/OG/JSON-LD
# and mobile universal links fall back to http://localhost:3000 without it).
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_TITLE="Flyee"
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_STORAGE_PREFIX="fly"
ENV=test
NEXT_PUBLIC_MUI_X_LICENSE_KEY="YOUR_MUIX_LICENSE_KEY"

# --- Supabase (leave empty to browse the template without auth) ---
# Project URL and anon key: Supabase dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Pooled connection string (port 6543) for @flyee/db (Drizzle).
DATABASE_URL=
# Server-only. Service role key — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Billing (optional; providers without a key are hidden at checkout) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# Default: Asaas sandbox. Production: https://api.asaas.com/v3
ASAAS_BASE_URL=
# Force a provider when more than one key is set (stripe | asaas). Default: first configured.
BILLING_PROVIDER=asaas

# --- Ads & analytics (optional; empty = no tracker loads, banner stays hidden) ---
# Meta Pixel loads ONLY on the marketing site (never the clinical app).
# Events Manager > Data sources > your dataset > "Pixel ID".
NEXT_PUBLIC_META_PIXEL_ID=
# GA4 Measurement ID (G-XXXXXXXXXX): GA Admin > Data streams > Web stream.
NEXT_PUBLIC_GA4_ID=
# Server-only. GA4 Measurement Protocol API secret: GA Admin > Data streams >
# Web stream > Measurement Protocol API secrets > Create. Powers server-side
# sign_up / start_trial / begin_checkout / purchase (lib/ga4-mp.ts).
GA4_API_SECRET=
# Server-only. Conversions API access token: Events Manager > dataset >
# Settings > Conversions API > "Generate access token". Powers server-side
# InitiateCheckout / Purchase (lib/meta-capi.ts). Never expose to the client.
META_CAPI_TOKEN=
# Optional. Test-events code (Events Manager > Test events) to verify CAPI live.
META_CAPI_TEST_EVENT_CODE=

# --- AI assistants (a provider without a key rejects its assistants) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Clinical AI routing (optional; everything runs on Gemini when unset) ---
# Each clinical feature reads its own trio first: <FEATURE>_PROVIDER (gemini |
# anthropic | openai | openrouter), <FEATURE>_MODEL, <FEATURE>_EFFORT (low |
# medium | high | xhigh | max — Claude only). Features: EXTRACTION (anamnesis
# fill; falls back to TRANSCRIBE_MODEL), HYPOTHESES, PLAN, SUMMARY, ATTACHMENT.
# REASONING_* is the shared fallback, but never moves SUMMARY or ATTACHMENT to
# Anthropic, nor the extraction anywhere. A provider other than Gemini is a
# second processor of clinical data — confirm the data-processing terms first.
# Details: packages/ai/README.md ("What is NOT pluggable").
# HYPOTHESES_PROVIDER=anthropic
# HYPOTHESES_MODEL=claude-sonnet-5-5
# HYPOTHESES_EFFORT=medium
# /admin/insights answers on Gemini unless named here.
# INSIGHTS_PROVIDER=
# INSIGHTS_MODEL=

# --- Background jobs (optional; without keys, work falls back to inline) ---
# Local dev needs no keys: run "npx inngest-cli dev".
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Backups (@flyee/backup; needs DATABASE_URL + SUPABASE_SERVICE_ROLE_KEY) ---
# Days to keep backup runs and their archives before pruning (default 30).
BACKUP_RETENTION_DAYS=

# --- WhatsApp ---
# Needed to turn ON the sign-up's WhatsApp confirmation (migration 0122). The
# confirmation is a switch in /admin/support, born off: without these the
# sign-up keeps working, confirmed by e-mail only (the WhatsApp NUMBER is asked
# for either way). With it on, the professional sends a code from her own
# WhatsApp to WHATSAPP_SIGNUP_NUMBER and the inbound webhook
# (/api/webhooks/whatsapp/meta) confirms it. In production the switch refuses
# to turn on without the number AND a provider able to receive (Meta: token +
# phone id + app secret). Locally the number alone is enough; simulate her
# message with
#   select public.confirm_signup_verification(array['<CODE>'], '5511999990000');
# meta = official Cloud API (inbound + replies inside the 24h window need no
# approved template); evolution = unofficial (ban risk)
WHATSAPP_PROVIDER=
# Digits with country code, the Cloud API number whose webhook reaches this app.
WHATSAPP_SIGNUP_NUMBER=
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_ID=
WHATSAPP_META_VERIFY_TOKEN=
# App secret (Meta app dashboard → App settings → Basic). Without it the webhook
# refuses every payload, so no sign-up can be confirmed.
WHATSAPP_META_APP_SECRET=
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_WEBHOOK_TOKEN=

# --- Transactional email (optional; invites fall back to copyable links) ---
# Server-only. https://resend.com API key.
RESEND_API_KEY=
# Verified sender, e.g. "Flyee <noreply@yourdomain.com>"
EMAIL_FROM=

# --- Mobile universal links (required for store builds) ---
# Apple developer team identifier and SHA-256 fingerprint of the Android
# signing certificate. The web host comes from NEXT_PUBLIC_SITE_URL.
APPLE_TEAM_ID=
ANDROID_CERT_SHA256=
