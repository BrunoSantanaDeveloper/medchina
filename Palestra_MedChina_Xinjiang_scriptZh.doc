  font-size: 16pt;
  font-weight: bold;
  color: #177c81;
  margin: 6pt 0 2pt 0;
}
.slide-title-pt {
  font-size: 10pt;
  font-style: italic;
  color: #6b7280;
  margin-bottom: 4pt;
}
