{
  "name": "medchina",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @flyee/web",
    "dev:mobile": "npm run start -w @flyee/mobile",
    "build": "npm run build -w @flyee/web",
    "build:mobile": "npm run build -w @flyee/mobile",
    "start": "npm run start -w @flyee/web",
    "lint": "npm run lint -w @flyee/web",
    "lint:fix": "npm run lint:fix -w @flyee/web",
    "prettier": "npm run prettier -w @flyee/web",
    "harness:sync": "node scripts/sync-agent-harness.mjs",
    "harness:check": "node scripts/sync-agent-harness.mjs --check",
    "harness:test": "node scripts/test-agent-harness.mjs",
    "test:clinical": "npm test -w @flyee/clinical",
    "test:whatsapp": "npm test -w @flyee/whatsapp",
    "test:ai": "npm test -w @flyee/ai",
    "test": "npm run test:clinical && npm run test:whatsapp && npm run test:ai && npm run test:web && npm run test:mobile",
    "test:web": "npm run test -w @flyee/web",
    "test:mobile": "npm run test -w @flyee/mobile",
    "test:browser": "npm run test:browser -w @flyee/web",
    "test:e2e": "npm run test:e2e -w @flyee/web",
    "test:a11y": "npm run test:a11y -w @flyee/web",
    "db:prepare": "node scripts/prepare-supabase-local.mjs",
    "db:start": "npm run db:prepare && supabase start",
    "db:stop": "supabase stop --no-backup",
    "db:plan:remote": "node scripts/remote-db-gate.mjs",
    "db:migrate:remote": "node scripts/remote-db-gate.mjs --apply",
    "db:gate:remote": "node scripts/remote-db-gate.mjs --apply --test",
    "test:db": "supabase test db --local packages/db/tests",
    "test:db:ci": "supabase test db --db-url postgresql://postgres:postgres@127.0.0.1:54322/postgres packages/db/tests",
    "test:db:remote": "node scripts/remote-db-gate.mjs --test-only",
    "content:mobile": "node scripts/generate-mobile-messages.mjs",
    "content:mobile:check": "node scripts/generate-mobile-messages.mjs --check",
    "ci:verify": "npm run harness:check && npm run harness:test && npm run typecheck && npm run test && npm run build && npm run build:mobile",
    "tokens:generate": "npm run generate -w @flyee/design-tokens",
    "prepare": "husky || true",
    "pre-commit": "lint-staged",
    "typecheck": "npm run typecheck -w @flyee/clinical && npm run typecheck -w @flyee/web && npm run typecheck -w @flyee/mobile"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "16.1.2",
    "supabase": "^2.109.1"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@types/react": "19.2.7"
  }
}
